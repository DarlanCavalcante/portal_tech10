# Fonte do catálogo público da Tech10.
# Valores aceitos: store_backend | erp_stock
TECH10_CATALOG_SOURCE=store_backend

# Backend canônico do catálogo.
# Pode ser o storefront dedicado ou, no futuro, um BFF do ERP falando o mesmo contrato /api/store.
TECH10_CATALOG_BACKEND_URL=https://catalogo.tech10cloud.internal

# Estratégia de checkout.
# Valores aceitos: store_backend | quote_only
TECH10_CHECKOUT_MODE=store_backend

# Backend canônico de carrinho/checkout.
TECH10_CHECKOUT_BACKEND_URL=https://catalogo.tech10cloud.internal

# Fallback legado compatível para catálogo + checkout quando os campos acima não existirem.
TECH10_STORE_BACKEND_URL=

# Opcional. Se o backend exigir autenticação server-to-server.
TECH10_STORE_BEARER_TOKEN=
TECH10_CATALOG_BEARER_TOKEN=
TECH10_CHECKOUT_BEARER_TOKEN=

# Opcional. Alternativa a bearer quando o backend usa chave simples.
TECH10_STORE_API_KEY=
TECH10_CATALOG_API_KEY=
TECH10_CHECKOUT_API_KEY=

# Base do portal completo do ERP para cliente final.
TECH10_ERP_PORTAL_BASE_URL=https://sistema.tech10cloud.com/portal

# Base da consulta pública simples da O.S.
TECH10_ERP_STATUS_BASE_URL=https://sistema.tech10cloud.com/status

# Canal de atendimento usado quando a loja opera em modo quote_only.
TECH10_SUPPORT_WHATSAPP=55974001960
